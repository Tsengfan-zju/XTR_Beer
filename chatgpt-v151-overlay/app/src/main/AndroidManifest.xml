<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <queries>
        <package android:name="com.autonavi.minimap" />
    </queries>

    <application
        android:name=".UreaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.UreaClient">

        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".DeviceSettingsActivity" android:exported="false" />
        <activity android:name=".MyActivity" android:exported="false" />
        <activity android:name=".AddDeviceActivity" android:exported="false" />
        <activity android:name=".AlertsActivity" android:exported="false" />
        <activity android:name=".SalesActivity" android:exported="false" />
        <activity android:name=".OrderDetailActivity" android:exported="false" />
        <activity android:name=".OrdersActivity" android:exported="false" />
        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".NearbyDevicesActivity" android:exported="false" />
        <activity android:name=".DeviceListActivity" android:exported="false" />
        <activity android:name=".DeviceDetailActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ureaclient" android:host="bootstrap" />
            </intent-filter>
        </activity>
    </application>

</manifest>
